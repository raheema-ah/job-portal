# ================================================
# Job Portal — Environment Variables
# Copy this file to .env and fill in your values
# ================================================

# Server
PORT=5001
NODE_ENV=development

# MongoDB (use your Atlas URI or local)
MONGO_URI=mongodb://localhost:27017/jobportal
# For Docker Compose, use:
# MONGO_URI=mongodb://admin:jobportal2026@mongodb:27017/jobportal?authSource=admin

# Docker MongoDB credentials (only used in docker-compose)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASS=jobportal2026
MONGO_DB_NAME=jobportal

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=7d

# Password Reset Token (hours)
RESET_TOKEN_EXPIRES_HOURS=1

# Email (SMTP) — e.g. Gmail App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=Jobora <noreply@jobora.com>

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173

# Scraper cron schedule (default: every 6 hours)
SCRAPER_SCHEDULE=0 */6 * * *
